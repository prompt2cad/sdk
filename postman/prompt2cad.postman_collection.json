        {
          "name": "Upload CAD source bytes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cad-files?fileName={{cad_file_name}}&units={{cad_units}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cad-files"
              ],
              "query": [
                {
                  "key": "fileName",
                  "value": "{{cad_file_name}}"
                },
                {
                  "key": "units",
                  "value": "{{cad_units}}"
                }
              ]
            },
            "description": "Select a local file in Body → binary. Supported: DWG, DXF, SKP, OBJ, STL, GLB and self-contained glTF. Source 10 MiB, normalized geometry 8 MiB, retained sources 16 MiB/project. Each retry creates a new upload ID.",
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.id) pm.collectionVariables.set(\"cad_file_id\", data.id);",
                  "  ",
                  "  ",
                  "  ",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
