{
  "info": {
    "_postman_id": "f46baf25-4732-4cc1-b87b-e921f852c9d2",
    "name": "Prompt2CAD API — Generate, Modify CAD, Refine and Export",
    "description": "Official Prompt2CAD API workflows. Set api_key in a private environment or replace the bearer token with a Postman Vault reference. Run requests one at a time in the documented order; do not Run All because generations are asynchronous and spend credits. run_id is generated once if empty; retain it when retrying unchanged operations and change it for a new workflow. Default model: default. Budget model: deepseek/deepseek-v4.1-flash. Docs: https://prompt2cad.com/documentation/integrations/api · SDK: https://github.com/prompt2cad/sdk · OpenAPI: https://prompt2cad.com/api/v1/openapi.json. Exports and uploads add no customer credit debit; generation and paid auxiliary tools use the account credit balance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://prompt2cad.com/api/v1",
      "type": "string"
    },
    {
      "key": "origin",
      "value": "https://prompt2cad.com",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string"
    },
    {
      "key": "run_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "generation_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "generation_status",
      "value": "",
      "type": "string"
    },
    {
      "key": "export_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "download_path",
      "value": "",
      "type": "string"
    },
    {
      "key": "cad_file_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "image_file_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "cad_file_name",
      "value": "plate.stl",
      "type": "string"
    },
    {
      "key": "cad_units",
      "value": "mm",
      "type": "string"
    },
    {
      "key": "model",
      "value": "default",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get(\"run_id\")) pm.collectionVariables.set(\"run_id\", pm.variables.replaceIn(\"{{$guid}}\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — Credits and project",
      "item": [
        {
          "name": "Read account credits",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/usage",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usage"
              ]
            },
            "description": "Read account credits and limits without starting generation."
          },
          "event": [],
          "response": []
        },
        {
          "name": "Create a generation project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{run_id}}:project"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects"
              ]
            },
            "description": "Creates a project and stores project_id. No CAD generation or credit debit occurs here.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Prompt2CAD integration example\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.id) pm.collectionVariables.set(\"project_id\", data.id);",
                  "  ",
                  "  [\"generation_id\", \"generation_status\", \"export_id\", \"download_path\"].forEach(key => pm.collectionVariables.unset(key));",
                  "  ",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "02 — Generate and refine",
      "description": "Generate, then poll to completion before refining. The refinement example selects the budget model explicitly.",
      "item": [
        {
          "name": "Generate a mounting bracket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{run_id}}:generate"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/generations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "generations"
              ]
            },
            "description": "Starts a credit-consuming generation/refinement. Saves generation_id. Poll manually every five seconds; 202 means accepted, not completed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Create an L bracket, 100 mm wide, with 60 mm legs, 6 mm walls and two 8 mm mounting holes.\",\n  \"model\": \"{{model}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"project_id\")) { pm.execution.skipRequest(); throw new Error(\"Set project_id by completing the preceding workflow step first.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.id) pm.collectionVariables.set(\"generation_id\", data.id);",
                  "  if (data.status) pm.collectionVariables.set(\"generation_status\", data.status);",
                  "  ",
                  "  ",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Poll initial generation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/generations/{{generation_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "generations",
                "{{generation_id}}"
              ]
            },
            "description": "Read-only status and usage. Send every five seconds until completed. Stop on paused, awaiting_input, failed or cancelled. This collection never resumes a paid segment automatically."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"project_id\")) { pm.execution.skipRequest(); throw new Error(\"Set project_id by completing the preceding workflow step first.\"); }",
                  "if (!pm.variables.get(\"generation_id\")) { pm.execution.skipRequest(); throw new Error(\"Set generation_id by completing the preceding workflow step first.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.id) pm.collectionVariables.set(\"generation_id\", data.id);",
                  "  if (data.status) pm.collectionVariables.set(\"generation_status\", data.status);",
                  "  ",
                  "  ",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refine with DeepSeek V4.1 Flash",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{run_id}}:refine"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/generations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "generations"
              ]
            },
            "description": "Starts a credit-consuming generation/refinement. Saves generation_id. Poll manually every five seconds; 202 means accepted, not completed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Increase the bracket width to 120 mm. Keep the leg lengths, wall thickness and hole diameters unchanged.\",\n  \"model\": \"deepseek/deepseek-v4.1-flash\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"project_id\")) { pm.execution.skipRequest(); throw new Error(\"Set project_id by completing the preceding workflow step first.\"); }"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get(\"generation_status\") !== \"completed\") { pm.execution.skipRequest(); throw new Error(\"Poll the generation until completed before refining or exporting.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.id) pm.collectionVariables.set(\"generation_id\", data.id);",
                  "  if (data.status) pm.collectionVariables.set(\"generation_status\", data.status);",
                  "  ",
                  "  ",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Poll refinement",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/generations/{{generation_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "generations",
                "{{generation_id}}"
              ]
            },
            "description": "Read-only status and usage. Send every five seconds until completed. Stop on paused, awaiting_input, failed or cancelled. This collection never resumes a paid segment automatically."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"project_id\")) { pm.execution.skipRequest(); throw new Error(\"Set project_id by completing the preceding workflow step first.\"); }",
                  "if (!pm.variables.get(\"generation_id\")) { pm.execution.skipRequest(); throw new Error(\"Set generation_id by completing the preceding workflow step first.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.id) pm.collectionVariables.set(\"generation_id\", data.id);",
                  "  if (data.status) pm.collectionVariables.set(\"generation_status\", data.status);",
                  "  ",
                  "  ",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
