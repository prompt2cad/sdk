                  "  ",
                  "  [\"generation_id\", \"generation_status\", \"export_id\", \"download_path\"].forEach(key => pm.collectionVariables.unset(key));",
                  "  ",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Upload reference image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "image/png"
              }
            ],
            "url": {
              "raw": "{{base_url}}/files",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "files"
              ]
            },
            "description": "Select a local PNG using Body → binary. Stores image_file_id. Image limits: 20 MiB and 40 megapixels; normalized to JPEG at a 768-pixel longest side.",
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.id) pm.collectionVariables.set(\"image_file_id\", data.id);",
                  "  ",
                  "  ",
                  "  ",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Generate from the reference image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{run_id}}:image-generate"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/generations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "generations"
              ]
            },
            "description": "Starts a credit-consuming generation/refinement. Saves generation_id. Poll manually every five seconds; 202 means accepted, not completed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Model the bracket shown in this reference. Its base is 100 mm wide; use 6 mm walls and 8 mm mounting holes.\",\n  \"model\": \"{{model}}\",\n  \"imageFileIds\": [\n    \"{{image_file_id}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"project_id\")) { pm.execution.skipRequest(); throw new Error(\"Set project_id by completing the preceding workflow step first.\"); }",
                  "if (!pm.variables.get(\"image_file_id\")) { pm.execution.skipRequest(); throw new Error(\"Set image_file_id by completing the preceding workflow step first.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.id) pm.collectionVariables.set(\"generation_id\", data.id);",
                  "  if (data.status) pm.collectionVariables.set(\"generation_status\", data.status);",
                  "  ",
                  "  ",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Poll image-reference generation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/generations/{{generation_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "generations",
                "{{generation_id}}"
              ]
            },
            "description": "Read-only status and usage. Send every five seconds until completed. Stop on paused, awaiting_input, failed or cancelled. This collection never resumes a paid segment automatically."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"project_id\")) { pm.execution.skipRequest(); throw new Error(\"Set project_id by completing the preceding workflow step first.\"); }",
                  "if (!pm.variables.get(\"generation_id\")) { pm.execution.skipRequest(); throw new Error(\"Set generation_id by completing the preceding workflow step first.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.id) pm.collectionVariables.set(\"generation_id\", data.id);",
                  "  if (data.status) pm.collectionVariables.set(\"generation_status\", data.status);",
                  "  ",
                  "  ",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "05 — Export the completed revision",
      "description": "Exports the current completed generation. Immutable snapshot; later changes do not alter this export. Artifacts expire after seven days. Change formats to any supported output as needed.",
      "item": [
        {
          "name": "Request STEP, STL and PNG exports",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{run_id}}:export:{{generation_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/exports",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "exports"
              ]
            },
            "description": "Requests three formats. OBJ is ZIP/MTL; DXF is 3D geometry; PNG is a viewport preview. Export each completed generation with a distinct operation key.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"generationId\": \"{{generation_id}}\",\n  \"formats\": [\n    \"step\",\n    \"stl\",\n    \"png\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"project_id\")) { pm.execution.skipRequest(); throw new Error(\"Set project_id by completing the preceding workflow step first.\"); }",
                  "if (!pm.variables.get(\"generation_id\")) { pm.execution.skipRequest(); throw new Error(\"Set generation_id by completing the preceding workflow step first.\"); }"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get(\"generation_status\") !== \"completed\") { pm.execution.skipRequest(); throw new Error(\"Poll the generation until completed before refining or exporting.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.id) pm.collectionVariables.set(\"export_id\", data.id);",
                  "  ",
                  "  ",
                  "  pm.collectionVariables.unset(\"download_path\");",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Poll export and select a download",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/exports/{{export_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "exports",
                "{{export_id}}"
              ]
            },
            "description": "Read export status and check every artifact: individual formats can fail. Saves the first successful artifact download path; edit download_path to download another completed artifact."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"project_id\")) { pm.execution.skipRequest(); throw new Error(\"Set project_id by completing the preceding workflow step first.\"); }",
                  "if (!pm.variables.get(\"export_id\")) { pm.execution.skipRequest(); throw new Error(\"Set export_id by completing the preceding workflow step first.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  const artifact = (data.artifacts || []).find(item => item.status === \"completed\" && /^\\/api\\/v1\\/artifacts\\/[^/]+\\/download$/.test(item.downloadUrl || \"\"));",
                  "  if (artifact) pm.collectionVariables.set(\"download_path\", artifact.downloadUrl);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Download a completed artifact",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{origin}}{{download_path}}",
            "description": "Authenticated binary download. Use Send and Download in Postman to save it locally. Artifacts are retained for seven days."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"download_path\")) { pm.execution.skipRequest(); throw new Error(\"Set download_path by completing the preceding workflow step first.\"); }"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!/^\\/api\\/v1\\/artifacts\\/[^/]+\\/download$/.test(pm.variables.get(\"download_path\"))) { pm.execution.skipRequest(); throw new Error(\"Use a download path returned by this API export.\"); }"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
